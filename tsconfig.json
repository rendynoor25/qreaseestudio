{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["web/**/*.js", "web/**/*.ts"],
  "exclude": ["node_modules", "dist", "target", "data", "data-lan-demo", "web/studio.js", "web/cad-export.js", "web/skp-import.js"]
}
