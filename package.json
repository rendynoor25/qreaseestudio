{
  "private": true,
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "check:generated": "node scripts/build-studio.cjs --check && node scripts/build-line.cjs --check && node scripts/build-cad.cjs --check",
    "build:studio": "node scripts/build-studio.cjs",
    "verify": "npm run check && npm run check:generated && node scripts/test-line-geometry.cjs && cargo test --locked",
    "test:geometry": "node scripts/build-line.cjs && node scripts/test-line-geometry.cjs",
    "build:line": "node scripts/build-line.cjs",
    "build:cad": "node scripts/build-cad.cjs",
    "build:demo": "node scripts/build-demo.cjs"
  },
  "dependencies": {
    "@node-projects/acad-ts": "^3.10.0",
    "@supabase/supabase-js": "2.119.2",
    "earcut": "^3.2.4",
    "openskp": "^1.7.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
